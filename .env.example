# Ninguna es obligatoria: sin ellas la plataforma sirve la ultima observacion
# real guardada y lo indica en la interfaz. Nunca inventa valores.

# Base de datos con el historico de observaciones
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Trends automático. El plan gratuito de SerpApi cubre 15 destinos
# agrupados en tres consultas nocturnas.
SERPAPI_API_KEY=
# Alias admitido por compatibilidad con el despliegue actual: SerpAPI=

# Protege el endpoint que invoca Vercel Cron.
CRON_SECRET=

# Modelo de lenguaje. Se detecta el proveedor por el prefijo de la clave:
#   sk-ant-...  ->  Anthropic
#   cualquier otra  ->  API compatible con OpenAI
# Tambien se aceptan los nombres Claude_LLM, ANTHROPIC_API_KEY y OPENAI_API_KEY.
IA_API_KEY=
IA_URL=
IA_MODELO=

# Publicación en borradores de TikTok. El token pertenece al usuario autorizado
# y se mantiene exclusivamente en servidor. En producción se sustituirá por OAuth.
TIKTOK_ACCESS_TOKEN=
